@article{YUAN2026104126,
title = {Mind-CAD: An interpretable multimodal framework for image-guided CAD DSL generation and editing},
journal = {Computer-Aided Design},
volume = {199},
pages = {104126},
year = {2026},
issn = {0010-4485},
doi = {https://doi.org/10.1016/j.cad.2026.104126},
url = {https://www.sciencedirect.com/science/article/pii/S0010448526000965},
author = {Meng Yuan and Dawei Lin and Hongxia Xie and Tieru Wu and Rui Ma},
keywords = {Computer-aided design, CAD generative modeling, Image-guided modeling, Multimodal learning, Interpretable modeling},
abstract = {As Computer-Aided Design (CAD) evolves toward automation and intelligence, harnessing advanced technologies to serve human creativity and design intent remains a pivotal challenge in fostering human-machine collaborative innovation. While existing methods have achieved the translation from design intent to CAD models, they generally lack the capability to support continuous, interactive iteration based on user feedback. To address this, we propose Mind-CAD, an interpretable framework capable of both generation and editing. Mind-CAD generates a Domain-Specific Language (DSL) from the input image, which is a Python-like code representation of the CAD model. Based on the generated DSL, Mind-CAD can further perform editing operations to align with the user’s design intent. Specifically, we design a CAD Generator that leverages depth and normal information from the input image to guide the generation of more reliable DSL code. We then propose a CAD Planner to parse the generated DSL and the editing instruction, and to generate a detailed modification plan. Finally, we introduce a CAD Executor that applies edits at the corresponding locations in the DSL according to the plan. In addition, we introduce Mind-CAD EditBench, a benchmark designed to evaluate generative and editing capabilities across varying levels of geometric complexity. Extensive experiments demonstrate the effectiveness of Mind-CAD across multiple tasks.}
}